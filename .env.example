# =============================================================
#  PROJETO ALFRED PENNYWORTH — configuração central
#  Copie para .env e preencha os valores reais
#  NUNCA adicione comentários na mesma linha de um valor
# =============================================================

# ── Rede / Host ───────────────────────────────────────────────
HOST_IP=172.17.0.1
OLLAMA_BASE_URL=http://172.17.0.1:11434

# ── Portas dos serviços ───────────────────────────────────────
PORT_WEBUI=3000
PORT_SEARXNG=8888
PORT_N8N=5678
PORT_CHROMADB=8000
PORT_SHELL_EXECUTOR=7070
PORT_RESEARCHER=7071

# ── Modelos Ollama ────────────────────────────────────────────
MODEL_CHAT=llama3.1:8b
MODEL_EMBED=nomic-embed-text-v2-moe:latest

# ── Vaults Obsidian ───────────────────────────────────────────
VAULT_PEDRO=
VAULT_ALFRED=
# Cofre de notícias (jornal diário + podcast semanal), com .obsidian próprio. Fica DENTRO do
# VAULT_ALFRED para o Open WebUI (que só monta /vaults/alfred) continuar lendo o jornal.
# Vazio = usa o próprio VAULT_ALFRED (layout antigo: VAULT_ALFRED/jornal).
# Ex.: VAULT_NOTICIAS=/home/voce/Documentos/Obsidian---Alfred/Noticias
VAULT_NOTICIAS=

# ── Open WebUI ────────────────────────────────────────────────
WEBUI_SECRET_KEY=
WEBUI_AUTH=true
WEBUI_URL=http://localhost:3000
WEBUI_API_TOKEN=

# ── SearXNG ───────────────────────────────────────────────────
SEARXNG_URL=http://localhost:8888

# ── ChromaDB ──────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000
CHROMADB_COLLECTION=alfred-brain

# ── N8N ───────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=

# ── Shell Executor ────────────────────────────────────────────
SHELL_EXECUTOR_TOKEN=

# ── Researcher ────────────────────────────────────────────────
RESEARCHER_KB_ALFRED_ID=
RESEARCHER_KB_PEDRO_ID=

# ── ChromaDB Indexer ──────────────────────────────────────────
CHUNK_SIZE=300

# ── Ollama — comportamento ────────────────────────────────────
# OLLAMA_THINK: false desliga o "thinking" (gemma4/qwen3). Vazio = campo não enviado
# (necessário para modelos sem suporte a thinking, ex.: llama3.1)
OLLAMA_THINK=
# Contexto (tokens) enviado em options.num_ctx. Vazio = default do Ollama (4096)
OLLAMA_NUM_CTX=8192
# Modelo mais leve para classificação de e-mails. Vazio = MODEL_CHAT
MODEL_CLASSIFY=
# Modelo com entrada de áudio para transcrever (precisa da capacidade "audio" no Ollama — gemma4 tem).
# Vazio = MODEL_CHAT. Fallback automático: faster-whisper, se instalado no venv do inbox
MODEL_TRANSCRIBE=

# ── Inbox Assistant (Thunderbird) ─────────────────────────────
# Diretório do perfil do Thunderbird. Vazio = descoberta automática (snap, deb, flatpak)
THUNDERBIRD_PROFILE=
# Inbox padrão (chave em services/_shared/perfis.yml → inbox:)
INBOX_DEFAULT=pedro_hotmail
# Toca o áudio da pergunta automaticamente ao criar uma pendência
INBOX_AUTOPLAY=false
# Player de áudio (vazio = ffplay → mpv → xdg-open)
INBOX_AUDIO_PLAYER=
# Porta do serviço HTTP do inbox (usado pelo N8N)
PORT_INBOX=7072
# Painel do Alfred (http://127.0.0.1:7072/painel, login com o SHELL_EXECUTOR_TOKEN):
# validade da sessão em dias (aceita fração, ex.: 0.5). Vazio ou inválido = 7
PAINEL_SESSAO_DIAS=7
# Backend IMAP direto (opcional; Outlook/Hotmail exige OAuth2 e NÃO funciona por aqui)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ── WhatsApp — Evolution API (Poder 3) ────────────────────────
# Porta do container (publicada só em 127.0.0.1)
PORT_EVOLUTION=8080
# URL vista pelo Inbox Assistant (host). VAZIO = envio simulado: nada sai da máquina,
# os envios ficam em logs/whatsapp_enviados.jsonl
EVOLUTION_URL=http://localhost:8080
# AUTHENTICATION_API_KEY do container e chave aceita em POST /whatsapp/webhook (gere: openssl rand -hex 16)
EVOLUTION_API_KEY=
# Nome da instância pareada por QR code (services/inbox/run.sh whatsapp qrcode)
EVOLUTION_INSTANCE=alfred
# Senha do PostgreSQL interno da Evolution (gere: openssl rand -hex 12)
EVOLUTION_POSTGRES_PASSWORD=
# Número de Pedro com DDI, só dígitos (ex.: 5514999998888). Recebe o resumo + áudio de cada pendência
# e é de onde vêm as respostas ("responda citando esta mensagem"). Pode ser o próprio número da instância
WHATSAPP_NUMERO_PEDRO=
# true = nunca envia de verdade, mesmo com EVOLUTION_URL configurada (testes)
WHATSAPP_DRY_RUN=false
# Conta em services/_shared/perfis.yml → whatsapp:
WHATSAPP_DEFAULT=pedro_whatsapp
