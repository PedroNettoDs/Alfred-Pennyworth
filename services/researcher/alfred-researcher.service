[Unit]
Description=Alfred Research Service (FastAPI :PORT_RESEARCHER, padrão 7072)
After=network-online.target
# Unit de USUÁRIO, como as do inbox: roda com o mesmo usuário que antes ia em User= (sem sudo).
# run.sh carrega o .env da raiz e escolhe a porta (PORT_RESEARCHER).

[Service]
Type=simple
WorkingDirectory=@ALFRED_DIR@/services/researcher
ExecStart="@ALFRED_DIR@/services/researcher/run.sh"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

# INSTALAÇÃO: modelo — services/scripts/instalar.sh troca @ALFRED_DIR@ pelo caminho real do repositório
# e grava a unit em ~/.config/systemd/user/. Máquina que já tem a unit de SISTEMA antiga
# (/etc/systemd/system/alfred-researcher.service): o instalar.sh não instala esta e avisa.
