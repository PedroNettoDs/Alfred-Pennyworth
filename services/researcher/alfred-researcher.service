[Unit]
Description=Alfred Research Service
After=network.target

[Service]
Type=simple
User=pedro.netto
WorkingDirectory=/mnt/SSD/alfred/services/researcher
EnvironmentFile=/mnt/SSD/alfred/.env
ExecStart=/mnt/SSD/alfred/services/researcher/venv/bin/uvicorn main:app --host 0.0.0.0 --port 7071
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
