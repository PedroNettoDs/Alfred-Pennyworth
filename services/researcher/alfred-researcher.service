[Unit]
Description=Alfred Research Service
After=network.target

[Service]
Type=simple
User=netto
WorkingDirectory=/home/netto/Alfred-Pennyworth/services/researcher
EnvironmentFile=/home/netto/Alfred-Pennyworth/.env
ExecStart=/home/netto/Alfred-Pennyworth/services/researcher/venv/bin/uvicorn main:app --host 0.0.0.0 --port 7071
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
