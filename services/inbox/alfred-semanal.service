[Unit]
Description=Alfred — podcast a cada 3 dias (jornal do e-mail + briefings → diálogo em 2 vozes + manifesto)
After=network-online.target
# Disparado por alfred-semanal.timer. Unit de USUÁRIO: instale em ~/.config/systemd/user/

[Service]
Environment=ALFRED_AUTOMACAO=1
Type=oneshot
WorkingDirectory=@ALFRED_DIR@/services/inbox
ExecStart="@ALFRED_DIR@/services/inbox/run.sh" podcast --se-devido
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600

[Install]
WantedBy=default.target

# INSTALAÇÃO: modelo — services/scripts/instalar.sh troca @ALFRED_DIR@ pelo caminho real do repositório
# e grava a unit em ~/.config/systemd/user/ (não copie este arquivo direto).
