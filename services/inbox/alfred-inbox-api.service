[Unit]
Description=Alfred Inbox API (FastAPI :7072) — fachada HTTP para o N8N
After=network-online.target

[Service]
Environment=ALFRED_AUTOMACAO=1
Type=simple
WorkingDirectory=%h/dev/Alfred-Pennyworth/services/inbox
ExecStart=%h/dev/Alfred-Pennyworth/services/inbox/run.sh serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# INSTALAÇÃO (sem sudo):
#   cp alfred-inbox-api.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now alfred-inbox-api
#   curl -s http://localhost:7072/health
