[Unit]
Description=Timer — Alfred vigia (2 min após o login e a cada 10 min)

[Timer]
# Só OnStartupSec: numa unit de usuário conta do início do gerenciador do usuário (= login, ou boot com linger).
# OnBootSec=2min já vencia antes do login e o vigia rodava junto com a API ainda subindo (e a reiniciava).
OnStartupSec=2min
OnUnitActiveSec=10min
Persistent=false

[Install]
WantedBy=timers.target
