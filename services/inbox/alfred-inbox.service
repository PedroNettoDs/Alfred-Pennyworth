[Unit]
Description=Alfred Inbox Assistant — ciclo (Thunderbird → jornal + pendências)
After=network-online.target
# Disparado por alfred-inbox.timer. Unit de USUÁRIO (precisa da sessão gráfica
# para notify-send / áudio): instale em ~/.config/systemd/user/

[Service]
Environment=ALFRED_AUTOMACAO=1
Type=oneshot
WorkingDirectory=%h/dev/Alfred-Pennyworth/services/inbox
ExecStart=%h/dev/Alfred-Pennyworth/services/inbox/run.sh ciclo
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

[Install]
WantedBy=default.target

# INSTALAÇÃO (sem sudo):
#   mkdir -p ~/.config/systemd/user
#   cp alfred-inbox.service alfred-inbox.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now alfred-inbox.timer
#   systemctl --user list-timers alfred-inbox.timer
#   journalctl --user -fu alfred-inbox
