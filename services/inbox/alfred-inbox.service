[Unit]
Description=Alfred Inbox Assistant — ciclo (Thunderbird → jornal + pendências)
After=network-online.target
# Disparado por alfred-inbox.timer. Unit de USUÁRIO (precisa da sessão gráfica
# para notify-send / áudio): instale em ~/.config/systemd/user/

[Service]
Environment=ALFRED_AUTOMACAO=1
Type=oneshot
WorkingDirectory=@ALFRED_DIR@/services/inbox
ExecStart="@ALFRED_DIR@/services/inbox/run.sh" ciclo
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

[Install]
WantedBy=default.target

# INSTALAÇÃO: modelo — services/scripts/instalar.sh troca @ALFRED_DIR@ pelo caminho real do repositório
# e grava a unit em ~/.config/systemd/user/ (não copie este arquivo direto).
