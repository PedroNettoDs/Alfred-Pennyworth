[Unit]
Description=Alfred Briefing Matinal (matinal_tech — RSS de tecnologia)
After=network-online.target
# Disparado por alfred-briefing-matinal.timer. Unit de USUÁRIO (como as do inbox): ~/.config/systemd/user/

[Service]
Environment=ALFRED_AUTOMACAO=1
Type=oneshot
WorkingDirectory=%h/dev/Alfred-Pennyworth/services/briefing
ExecStart=%h/dev/Alfred-Pennyworth/services/briefing/run.sh matinal_tech
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

# INSTALAÇÃO (sem sudo):
#   cp alfred-briefing-matinal.service alfred-briefing-matinal.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now alfred-briefing-matinal.timer
