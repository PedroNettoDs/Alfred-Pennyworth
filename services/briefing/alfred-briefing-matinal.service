[Unit]
Description=Alfred Briefing Matinal (matinal_tech)
After=network.target
# Disparado pelo alfred-briefing-matinal.timer às 07:00 diariamente

[Service]
Type=oneshot
User=netto
WorkingDirectory=/home/netto/Alfred-Pennyworth/services/briefing
EnvironmentFile=/home/netto/Alfred-Pennyworth/.env
ExecStart=/home/netto/Alfred-Pennyworth/services/briefing/run.sh matinal_tech
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# INSTALAÇÃO:
# sudo cp alfred-briefing-matinal.service alfred-briefing-matinal.timer /etc/systemd/system/
# sudo systemctl daemon-reload
# sudo systemctl enable --now alfred-briefing-matinal.timer
# systemctl list-timers alfred-briefing-matinal.timer
