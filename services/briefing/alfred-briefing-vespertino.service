[Unit]
Description=Alfred Briefing Vespertino (vespertino_mercado — AttanoTech)
After=network-online.target
# Disparado por alfred-briefing-vespertino.timer. Unit de USUÁRIO (como as do inbox): ~/.config/systemd/user/

[Service]
Environment=ALFRED_AUTOMACAO=1
Type=oneshot
WorkingDirectory=%h/dev/Alfred-Pennyworth/services/briefing
ExecStart=%h/dev/Alfred-Pennyworth/services/briefing/run.sh vespertino_mercado
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800

# INSTALAÇÃO (sem sudo):
#   cp alfred-briefing-vespertino.service alfred-briefing-vespertino.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now alfred-briefing-vespertino.timer
