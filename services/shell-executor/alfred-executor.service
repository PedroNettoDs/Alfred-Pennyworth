[Unit]
Description=Alfred Shell Executor
After=network.target

[Service]
Type=simple
User=netto
WorkingDirectory=/home/netto/Alfred-Pennyworth/services/shell-executor
EnvironmentFile=/home/netto/Alfred-Pennyworth/.env
ExecStart=/home/netto/Alfred-Pennyworth/services/shell-executor/venv/bin/uvicorn main:app --host 0.0.0.0 --port 7070
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
